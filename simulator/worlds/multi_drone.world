<?xml version="1.0"?> 
<sdf version="1.5">
  <world name="default">
    <physics type="ode">
      <ode>
        <solver>
          <type>quick</type>
          <iters>100</iters>
          <sor>1.0</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.9</erp>
          <contact_max_correcting_vel>0.1</contact_max_correcting_vel>
          <contact_surface_layer>0.0</contact_surface_layer>
        </constraints>
      </ode>
      <real_time_update_rate>-1</real_time_update_rate>
    </physics>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>-35.3627754</latitude_deg>
      <longitude_deg>149.1658777</longitude_deg>
      <elevation>0.0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>5000 5000</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1</mu>
                <mu2>1</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="runway">
          <pose>000 0 0.005 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1829 45</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Runway</name>
            </script>
          </material>
        </visual>

        <visual name="grass">
          <pose>0 0 -0.1 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>5000 5000</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grass</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://sun</uri>
    </include>

    <model name="drone1">
      <pose>0 0 0 0 0 0</pose>
      <include>
        <uri>model://drone1</uri>
      </include>
    </model>

    <model name="drone2">
      <pose>0 -5 0 0 0 1.57</pose>
      <include>
        <uri>model://drone2</uri>
      </include>
    </model>

    <model name="drone3">
      <pose>5 -5 0 0 0 3.14</pose>
      <include>
        <uri>model://drone3</uri>
      </include>
    </model>

    <!-- SCENARIO: 10 Stationary Actors (No Animation) optimized for 10m altitude -->
    <!-- Grouped: 1 Isolated, 1 Triple Group, 3 Double Groups -->

    <!-- SCENARIO: Perspective-Based Stress Test (Total 10 Actors) -->
    <!-- TEST SITE 1: Visible from Drone at X ~ 35 (Looking towards +X) -->
    <!-- TIGHTENED (Y = -20 to +20) for better perspective alignment -->
    
    <!-- Group 1: Triple Group at X=60 (South side of Site 1) -->
    <actor name="site1_triple_a">
        <skin><filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename></skin>
        <script><loop>true</loop><trajectory id="1" type="stand">
            <waypoint><time>0</time><pose>60 -18 1.25 0 0 3.14</pose></waypoint>
            <waypoint><time>1</time><pose>60 -18 1.25 0 0 3.14</pose></waypoint>
        </trajectory></script>
    </actor>
    <actor name="site1_triple_b">
        <skin><filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename></skin>
        <script><loop>true</loop><trajectory id="2" type="stand">
            <waypoint><time>0</time><pose>60 -16 1.25 0 0 3.14</pose></waypoint>
            <waypoint><time>1</time><pose>60 -16 1.25 0 0 3.14</pose></waypoint>
        </trajectory></script>
    </actor>
    <actor name="site1_triple_c">
        <skin><filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename></skin>
        <script><loop>true</loop><trajectory id="3" type="stand">
            <waypoint><time>0</time><pose>60 -14 1.25 0 0 3.14</pose></waypoint>
            <waypoint><time>1</time><pose>60 -14 1.25 0 0 3.14</pose></waypoint>
        </trajectory></script>
    </actor>

    <!-- Group 2: Double Group at X=65 (Center of Site 1) -->
    <actor name="site1_double1_a">
        <skin><filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename></skin>
        <script><loop>true</loop><trajectory id="4" type="stand">
            <waypoint><time>0</time><pose>65 -1 1.25 0 0 3.14</pose></waypoint>
            <waypoint><time>1</time><pose>65 -1 1.25 0 0 3.14</pose></waypoint>
        </trajectory></script>
    </actor>
    <actor name="site1_double1_b">
        <skin><filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename></skin>
        <script><loop>true</loop><trajectory id="5" type="stand">
            <waypoint><time>0</time><pose>65 1 1.25 0 0 3.14</pose></waypoint>
            <waypoint><time>1</time><pose>65 1 1.25 0 0 3.14</pose></waypoint>
        </trajectory></script>
    </actor>

    <!-- Group 3: Double Group at X=70 (North side of Site 1) -->
    <actor name="site1_double2_a">
        <skin><filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename></skin>
        <script><loop>true</loop><trajectory id="6" type="stand">
            <waypoint><time>0</time><pose>70 14 1.25 0 0 3.14</pose></waypoint>
            <waypoint><time>1</time><pose>70 14 1.25 0 0 3.14</pose></waypoint>
        </trajectory></script>
    </actor>
    <actor name="site1_double2_b">
        <skin><filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename></skin>
        <script><loop>true</loop><trajectory id="7" type="stand">
            <waypoint><time>0</time><pose>70 16 1.25 0 0 3.14</pose></waypoint>
            <waypoint><time>1</time><pose>70 16 1.25 0 0 3.14</pose></waypoint>
        </trajectory></script>
    </actor>
  </world>
</sdf>
